[mysqld]
# --- Replica : 읽기 전용, primary 의 binlog 를 적용 ---
server-id                = 2
relay-log                = relay-bin
log-bin                  = mysql-bin
gtid-mode                = ON
enforce-gtid-consistency = ON
log-replica-updates      = ON
# 주의: read-only/super-read-only 는 여기 두지 않는다.
# MySQL 도커 엔트리포인트가 최초 부팅 시 root 비밀번호 설정·DB 생성 등 "쓰기"를 해야 하는데
# super-read-only 가 그 쓰기를 막아 초기화가 깨진다(root 빈 비번, 컨테이너 재시작 루프).
# 대신 replica-init 스크립트가 복제 구성 후 SET PERSIST 로 read-only 를 켠다(재시작에도 유지).
