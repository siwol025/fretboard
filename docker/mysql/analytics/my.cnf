[mysqld]
# --- Analytics replica : 집계/검색/리포팅 전용 읽기 노드, primary 의 binlog 를 적용 ---
# replica(server-id 2)와 물리적으로 독립된 노드(server-id 3)라, 무거운 스캔이
# replica(피드) 의 버퍼풀/IO 를 건드리지 않는다(워크로드 격리).
server-id                = 3
relay-log                = relay-bin
log-bin                  = mysql-bin
gtid-mode                = ON
enforce-gtid-consistency = ON
log-replica-updates      = ON
# read-only/super-read-only 는 여기 두지 않는다(엔트리포인트 초기화 쓰기 차단 회피).
# analytics-init 스크립트가 복제 구성 후 SET PERSIST 로 read-only 를 켠다.
