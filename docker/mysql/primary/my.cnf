[mysqld]
# --- Primary (source) : 쓰기 + binlog 발행 ---
server-id                = 1
log-bin                  = mysql-bin
binlog-format            = ROW
gtid-mode                = ON
enforce-gtid-consistency = ON
# 체인 복제/장애 대비: 복제로 적용한 변경도 자신의 binlog 에 기록
log-replica-updates      = ON
# 로컬 개발 편의: binlog 보존 3일
binlog-expire-logs-seconds = 259200
